# ---------------------------------------------------------------------------
# ResumeForge web app — environment configuration
# Copy this file to `.env.local` and fill in your values (.env.local is git-ignored).
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash, no /predict suffix).
#   REAL mode: a value here -> the app talks to the backend and hides the mock banner.
#   MOCK mode: leave EMPTY -> deterministic simulated output, clearly labelled.
# Start the backend with `uvicorn api.main:app --reload --port 8000`.
VITE_API_URL=http://localhost:8000

# Low-confidence threshold used by the demo panel to show the warning banner (0 - 1).
# Only used when the backend does not send its own `low_confidence` flag.
VITE_LOW_CONFIDENCE_THRESHOLD=0.5

# Per-request timeout in milliseconds before the client aborts (default 30000).
VITE_REQUEST_TIMEOUT_MS=30000

# Public repository URL (shown in the navbar hero and footer)
VITE_GITHUB_URL=https://github.com/renish-44/-Resume-Classification-System

# Optional: label shown next to the backend model name on the results card
VITE_MODEL_LABEL=