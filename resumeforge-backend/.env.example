# ResumeForge backend - example environment file.
# Copy to `.env` and adjust. NEVER commit the real .env: it is git-ignored.
# Every value below is the built-in default, so an empty .env also works.

# ---------------------------------------------------------------------------
# Model artifacts (relative paths are resolved against this project directory;
# absolute paths are used as-is). Only local files are ever loaded.
# ---------------------------------------------------------------------------
# Full fitted sklearn Pipeline (vectorizer + classifier), saved with joblib.
MODEL_PATH=models/model.joblib
# Used ONLY when MODEL_PATH does not exist.
VECTORIZER_PATH=models/vectorizer.joblib
# Used ONLY when MODEL_PATH does not exist.
CLASSIFIER_PATH=models/classifier.joblib
# Optional LabelEncoder; when absent the classifier's classes_ attribute is used.
LABEL_ENCODER_PATH=models/label_encoder.joblib
# Optional JSON with training metadata (model name, date, scikit-learn version).
MODEL_METADATA_PATH=models/metadata.json

# ---------------------------------------------------------------------------
# Evaluation reports (all optional; missing files yield empty results, never
# invented numbers): model_results.csv, per_class_metrics.csv,
# confusion_matrix.json, error_analysis.csv
# ---------------------------------------------------------------------------
REPORTS_DIR=reports

# ---------------------------------------------------------------------------
# HTTP layer
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed by CORS. Must include every
# origin the React app is served from:
#   http://localhost:5173  -> `npm run dev`
#   http://127.0.0.1:5173  -> Vite dev server bound to 127.0.0.1
#   http://localhost:4173  -> `npm run preview`
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=5
# slowapi rate limit applied to /predict and /predict/batch.
RATE_LIMIT=30/minute
# Deployment label. Change to "production" for a real deployment.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Text handling
# ---------------------------------------------------------------------------
# Maximum accepted resume text length, in characters.
MAX_TEXT_CHARS=100000
# Minimum accepted resume text length, in characters.
MIN_TEXT_CHARS=50
# Default number of ranked alternatives returned by /predict (1-10).
TOP_K=5
# Confidence below this value is flagged with "low_confidence": true.
CONFIDENCE_THRESHOLD=0.5
# Apply clean_text() before inference. Set to false when the saved pipeline
# already performs the training-time cleaning internally.
APPLY_EXTERNAL_PREPROCESSING=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional: relocate the project root (used by the Docker image)
# ---------------------------------------------------------------------------
# RESUMEFORGE_BASE_DIR=/app
